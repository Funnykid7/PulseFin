<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <!-- Required by PulseFinDownloadService's PlatformScheduler (JobScheduler-backed download
         resume), which persists jobs via setPersisted(true) — see PlatformScheduler's javadoc. -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <application>
        <service
            android:name="com.pulsefin.core.playback.service.PlaybackService"
            android:exported="true"
            android:foregroundServiceType="mediaPlayback">
            <intent-filter>
                <action android:name="androidx.media3.session.MediaSessionService" />
            </intent-filter>
        </service>

        <service
            android:name="com.pulsefin.core.playback.download.PulseFinDownloadService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />

        <!-- Declared per PlatformScheduler's javadoc so DownloadManager's JobScheduler-backed
             restart/resume actually works instead of throwing SecurityException on schedule(). -->
        <service
            android:name="androidx.media3.exoplayer.scheduler.PlatformScheduler$PlatformSchedulerService"
            android:permission="android.permission.BIND_JOB_SERVICE"
            android:exported="true" />
    </application>
</manifest>
